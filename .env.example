# ============================================================
# AICIT Backend – Environment Variables
# Copy this file to .env and fill in real values.
# NEVER commit .env to Git.
#
# Generate a JWT secret with:
#   openssl rand -base64 32
# ============================================================

# JWT (REQUIRED — must be base64-encoded, 32+ bytes decoded)
AICIT_JWT_SECRET=<generate with: openssl rand -base64 32>
AICIT_JWT_EXPIRATION_MS=86400000

# Database (dev: local PostgreSQL)
AICIT_DB_URL=jdbc:postgresql://localhost:5432/aicit_dev
AICIT_DB_USERNAME=postgres
AICIT_DB_PASSWORD=your_db_password

# Seed admin (dev only — creates the first SUPER_ADMIN on startup)
AICIT_ADMIN_EMAIL=admin@aicit.local
AICIT_ADMIN_PASSWORD=ChangeMe123!

# CORS (dev: Vite frontend)
AICIT_FRONTEND_URL=http://localhost:5174

# Mail / SMTP (set MAIL_ENABLED=true to actually send emails)
# For Gmail: use an App Password — not your account password
MAIL_ENABLED=false
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=noreply@yourdomain.com
MAIL_PASSWORD=your_smtp_app_password
MAIL_FROM=noreply@yourdomain.com

# API base URL (used in certificate QR codes)
AICIT_API_BASE_URL=http://localhost:8081

# Production only
# SPRING_PROFILES_ACTIVE=prod
# PORT=8081
